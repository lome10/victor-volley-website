rules_version = '2';

// Rispecchia le regole Firestore attuali (firestore.rules): lettura pubblica,
// scrittura per qualsiasi utente autenticato. Nessun controllo server-side
// su dirigenti/{uid}, coerente con il comportamento odierno di Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /players/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /staff/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /matches/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
