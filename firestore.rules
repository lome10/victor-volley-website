rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un account Firebase qualsiasi NON basta per scrivere: le registrazioni via
    // client sono aperte (il pannello crea gli account di atleti e dirigenti con
    // createUserWithEmailAndPassword), quindi ogni permesso passa da qui.
    function signedIn() {
      return request.auth != null;
    }

    // Dirigente = esiste il documento dirigenti/{uid}. Il documento può essere
    // creato solo da un dirigente (vedi la regola su /dirigenti più sotto).
    function isDirigente() {
      return signedIn() &&
        exists(/databases/$(database)/documents/dirigenti/$(request.auth.uid));
    }

    // Vero se l'account è l'atleta stesso (id = uid) o è elencato nei suoi accessUids
    // (genitori compresi). Serve a presenze e rate: non basta essere loggati.
    function possiedeAtleta(atletaId) {
      return signedIn() && (
        request.auth.uid == atletaId ||
        request.auth.uid in get(/databases/$(database)/documents/atleti/$(atletaId)).data.accessUids
      );
    }

    // Atleti — dati personali (in gran parte minorenni). Un documento lo leggono
    // gli account elencati in accessUids (l'atleta e/o i genitori); i documenti
    // vecchi, senza accessUids, restano leggibili dall'atleta con id = uid finché
    // il pannello admin non li migra. Tutto il resto è dei dirigenti.
    match /atleti/{atletaId} {
      allow read: if isDirigente() || (signedIn() && (
        request.auth.uid == atletaId ||
        ('accessUids' in resource.data && request.auth.uid in resource.data.accessUids)
      ));
      allow write: if isDirigente();
    }

    // Anagrafica completa degli atleti (codice fiscale, indirizzo, telefoni, tutori,
    // info mediche, note): dati personali di minori, SOLO dirigenti. Le famiglie
    // leggono unicamente la scheda /atleti, che ne contiene una parte minima.
    match /atletiDati/{atletaId} {
      allow read, write: if isDirigente();
    }

    // Accessi — un documento per account atleta/genitore, id = uid, con le
    // categorie dei suoi atleti. Lo mantiene il pannello admin (dirigenti); serve
    // alle regole degli avvisi per sapere cosa può leggere ogni famiglia.
    match /accessi/{uid} {
      allow read: if isDirigente() || (signedIn() && request.auth.uid == uid);
      allow write: if isDirigente();
    }

    // Avvisi ai tesserati: categoria = nome della squadra oppure 'tutte'. Li
    // leggono solo gli account con un documento in /accessi (cioè atleti e
    // genitori veri, non chiunque si registri) e solo per le proprie categorie.
    // Le query devono filtrare con categoria == X.
    function haAccessi() {
      return signedIn() &&
        exists(/databases/$(database)/documents/accessi/$(request.auth.uid));
    }
    function categorieAccesso() {
      return get(/databases/$(database)/documents/accessi/$(request.auth.uid)).data.categorie;
    }
    match /comunicazioni/{id} {
      allow read: if isDirigente() || (haAccessi() && (
        resource.data.categoria == 'tutte' ||
        resource.data.categoria in categorieAccesso()
      ));
      allow write: if isDirigente();
    }

    // Presenze — la risposta "ci sarò / non ci sarò" di una famiglia a una partita
    // o a un allenamento. Un documento per evento+atleta (id = eventKey_atletaId),
    // quindi rispondere di nuovo sovrascrive. Rispondono solo gli account elencati
    // nelle schede dell'atleta (o l'atleta stesso), e non si può scrivere per altri.
    match /presenze/{docId} {
      function rispostaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['eventKey', 'tipo', 'eventoId', 'data', 'categoria', 'atletaId', 'risposta', 'rispostaDa', 'rispostaIl']) &&
          d.keys().hasAll(['eventKey', 'tipo', 'eventoId', 'data', 'categoria', 'atletaId', 'risposta', 'rispostaDa', 'rispostaIl']) &&
          d.risposta in ['si', 'no'] &&
          d.tipo in ['partita', 'allenamento'] &&
          d.rispostaDa == request.auth.uid &&
          docId == d.eventKey + '_' + d.atletaId &&
          possiedeAtleta(d.atletaId) &&
          d.categoria == get(/databases/$(database)/documents/atleti/$(d.atletaId)).data.categoria;
      }
      allow read: if isDirigente() || possiedeAtleta(resource.data.atletaId);
      allow create, update: if isDirigente() || rispostaValida();
      allow delete: if isDirigente();
    }

    // Collezioni pubbliche del sito: lettura libera, scrittura solo dirigenti.
    match /articles/{document=**}   { allow read: if true; allow write: if isDirigente(); }
    match /partite/{document=**}    { allow read: if true; allow write: if isDirigente(); }
    match /allenamenti/{document=**} { allow read: if true; allow write: if isDirigente(); }
    match /albums/{document=**}     { allow read: if true; allow write: if isDirigente(); }
    match /categories/{document=**} { allow read: if true; allow write: if isDirigente(); }
    match /players/{document=**}    { allow read: if true; allow write: if isDirigente(); }
    match /staff/{document=**}      { allow read: if true; allow write: if isDirigente(); }
    match /settings/{document=**}   { allow read: if true; allow write: if isDirigente(); }
    match /siteData/{document=**}   { allow read: if true; allow write: if isDirigente(); }

    // Registro ruoli. Ognuno può leggere solo il proprio documento (serve al
    // controllo di accesso del pannello); i dirigenti vedono tutti. Scrivere qui
    // significa promuovere qualcuno a dirigente: solo un dirigente può farlo.
    match /dirigenti/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDirigente());
      allow write: if isDirigente();
    }

    // Area Dirigenti — dati di budget/CRM: solo dirigenti/admin, mai pubblico.
    match /budgetSeasons/{document=**}    { allow read, write: if isDirigente(); }
    match /aziende/{document=**}          { allow read, write: if isDirigente(); }
    match /sponsorizzazioni/{document=**} { allow read, write: if isDirigente(); }
    match /tranchePagamento/{document=**} { allow read, write: if isDirigente(); }
    match /attivita/{document=**}         { allow read, write: if isDirigente(); }
    match /promemoria/{document=**}       { allow read, write: if isDirigente(); }
    match /pianoEditoriale/{document=**}  { allow read, write: if isDirigente(); }
    match /bacheca/{document=**}          { allow read, write: if isDirigente(); }
    match /categorieAtleti/{document=**}  { allow read, write: if isDirigente(); }
    match /atletiRette/{document=**}      { allow read, write: if isDirigente(); }
    // Rate degli atleti: le scrivono solo i dirigenti; la famiglia legge solo quelle
    // dei propri atleti (campo atletaId, scritto dal pannello admin).
    match /rateAtleti/{rataId} {
      allow read: if isDirigente() || ('atletaId' in resource.data && possiedeAtleta(resource.data.atletaId));
      allow write: if isDirigente();
    }
    // Ricevute di pagamento: documenti contabili, mai cancellabili. Le crea un
    // dirigente (con una copia dei dati di pagatore e atleta al momento
    // dell'emissione); dopo, l'unica modifica ammessa è l'annullamento (valida →
    // annullata, con data e motivo). La famiglia legge solo quelle dei propri atleti
    // (campo atletaId): le query devono filtrare con atletaId == X.
    match /ricevute/{ricevutaId} {
      allow read: if isDirigente() ||
        ('atletaId' in resource.data && resource.data.atletaId is string && possiedeAtleta(resource.data.atletaId));
      allow create: if isDirigente();
      allow update: if isDirigente() &&
        resource.data.stato == 'valida' && request.resource.data.stato == 'annullata' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stato', 'dataAnnullamento', 'motivoAnnullamento', 'annullataDa']);
      allow delete: if false;
    }
    // Contatore progressivo delle ricevute (un documento per anno: { ultimo: n }).
    match /contatoriRicevute/{anno}       { allow read, write: if isDirigente(); }
    match /tessere/{document=**}          { allow read, write: if isDirigente(); }
    match /vociSpesa/{document=**}        { allow read, write: if isDirigente(); }
    match /sottospese/{document=**}       { allow read, write: if isDirigente(); }
    match /categorieSpesa/{document=**}   { allow read, write: if isDirigente(); }

    // Audit log — append-only: nessun update/delete concesso a nessuno, admin incluso.
    match /auditLog/{document=**} {
      allow read: if isDirigente();
      allow create: if isDirigente();
      allow update, delete: if false;
    }
  }
}
